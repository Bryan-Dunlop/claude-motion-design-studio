{
  "name": "claude-motion-design-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local motion-design editor: edit scenes, layers and keyframes in the browser, export MP4 via headless Chromium + ffmpeg.",
  "scripts": {
    "start": "node --import tsx server/dev.ts --built --open",
    "dev": "node --import tsx server/dev.ts",
    "render": "node --import tsx server/render-cli.ts",
    "postinstall": "node scripts/postinstall.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/adm-zip": "^0.5.8",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "adm-zip": "^0.6.1",
    "express": "^5.2.1",
    "immer": "^11.1.21",
    "playwright": "1.56.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "vite": "^8.3.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  }
}
